{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-rm.sh" }
        ]
      },
      {
        "matcher": "Edit.*",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.sh", "timout": 10 }
        ]
      },
      {
        "matcher": "mcp__github",
        "hooks": [
          { "type": "http", "url": "http://hooks.example.com/audit",
            "headers": { "Authorization": "Bearer $AUDIT_TOKEN" } }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "npx prettier --write .", "if": "Edit(*.ts) && Write(*.ts)" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "./scripts/notify.sh > /dev/tty" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "start",
        "hooks": [
          { "type": "prompt", "prompt": "Summarize the repo" }
        ]
      }
    ],
    "UserPromptSubmitted": [
      { "hooks": [ { "type": "command", "command": "echo hi" } ] }
    ]
  }
}
